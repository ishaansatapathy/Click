{
  "$comment": "PLAN §14.4. Classes are checked in this order: frozen, shared, open, laneA, laneB. First match wins. Unmatched paths are 'unowned' and follow the shared rule.",
  "frozen": [
    "packages/core/src/types.ts",
    "packages/core/src/store/types.ts",
    "packages/core/src/contracts.ts"
  ],
  "shared": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "packages/*/package.json",
    "bench/package.json",
    "tsconfig.json",
    "vitest.config.ts",
    "eslint.config.js",
    ".gitignore",
    ".gitattributes",
    ".env.example",
    "packages/core/src/config.ts",
    "packages/core/src/config.test.ts",
    "scripts/pair/**"
  ],
  "open": [
    "docs/**"
  ],
  "laneA": [
    "bench/**",
    "apps/**",
    "infra/**",
    "packages/core/src/store/**",
    "packages/core/src/retrieve/semantic*.ts",
    "packages/core/src/indexer/profile*.ts",
    "packages/click/src/mcp/**",
    "packages/click/src/install/{codex,claude-mcp}*.ts",
    "packages/click/src/cli/{init,uninstall,statusline,push,pull,probe}*.ts",
    "README.md"
  ],
  "laneB": [
    "packages/**"
  ]
}
