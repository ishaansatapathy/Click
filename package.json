{
  "name": "click-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "tsx bench/src/runner.ts",
    "bench:diff": "tsx bench/src/diff.ts",
    "bench:review": "tsx bench/src/review.ts",
    "bench:validate": "tsx bench/src/task.ts",
    "click": "tsx packages/click/src/cli/index.ts",
    "drill": "tsx bench/scripts/drill.ts",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "pair:setup": "tsx scripts/pair/setup.ts",
    "pair:sync": "tsx scripts/pair/sync.ts",
    "pair:status": "tsx scripts/pair/status.ts",
    "pair:mark": "tsx scripts/pair/mark.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.15.0",
    "picomatch": "^4.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
