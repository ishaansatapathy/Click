+/** 是否正在处理登录失效（避免并发请求重复提示和刷新） */
+let isHandlingUnauthorized = false
+
+/** 获取服务端返回的提示信息，没有则使用默认提示 */
+function getServerMessage(data: unknown, defaultMessage: string) {
+  const message = get(data, "message")
+  return typeof message === "string" && message.trim() ? message : defaultMessage
+}
+
+/** 处理未授权（401）：先提示，提示关闭后再退出登录 */
+function handleUnauthorized(message: string) {
+  if (isHandlingUnauthorized) return
+  isHandlingUnauthorized = true
+  ElMessage({
+    type: "error",
+    message,
+    duration: 1500,
+    onClose: logout
+  })
+}
+
 /** 创建请求实例 */
 function createInstance() {
   // 创建一个 axios 实例命名为 instance
