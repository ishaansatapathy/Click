diff --git a/tests/utils/redirect.test.ts b/tests/utils/redirect.test.ts
new file mode 100644
index 00000000..59c08df8
--- /dev/null
+++ b/tests/utils/redirect.test.ts
@@ -0,0 +1,36 @@
+import { resolveRedirect } from "@@/utils/redirect"
+import { describe, expect, it } from "vitest"
+
+describe("resolveRedirect", () => {
+  it("keeps internal path with query and hash", () => {
+    expect(resolveRedirect("/table/element-plus?page=2#top")).toBe("/table/element-plus?page=2#top")
+  })
+
+  it("falls back when empty or not a string", () => {
+    expect(resolveRedirect(undefined)).toBe("/")
+    expect(resolveRedirect(null)).toBe("/")
+    expect(resolveRedirect("")).toBe("/")
+    expect(resolveRedirect(123)).toBe("/")
+  })
+
+  it("uses the first value of an array query", () => {
+    expect(resolveRedirect(["/a", "/b"])).toBe("/a")
+  })
+
+  it("rejects external or protocol-relative urls", () => {
+    expect(resolveRedirect("https://evil.com")).toBe("/")
+    expect(resolveRedirect("//evil.com")).toBe("/")
+    expect(resolveRedirect("/\\evil.com")).toBe("/")
+    expect(resolveRedirect("javascript:alert(1)")).toBe("/")
+    expect(resolveRedirect("relative/path")).toBe("/")
+  })
+
+  it("rejects the login page itself", () => {
+    expect(resolveRedirect("/login")).toBe("/")
+    expect(resolveRedirect("/login?redirect=/a")).toBe("/")
+  })
+
+  it("supports a custom fallback", () => {
+    expect(resolveRedirect(undefined, "/home")).toBe("/home")
+  })
+})
