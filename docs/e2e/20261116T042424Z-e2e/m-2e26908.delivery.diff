+  // 回到第一页：已在第一页则直接请求，否则修改页码并由下方的 watch 触发请求，避免重复请求
+  const resetToFirstPage = () => {
+    paginationData.currentPage === 1 ? request?.() : (paginationData.currentPage = 1)
   }
 
-  // 改变每页显示条数
-  const handleSizeChange = (value: number) => {
-    paginationData.pageSize = value
+  if (request) {
+    // 初始加载放在 onMounted 中，避免 request 在 paginationData 等变量初始化完成前被同步调用
+    onMounted(request)
+    // 监听分页参数的变化
+    watch([() => paginationData.currentPage, () => paginationData.pageSize], request)
   }
 
-  return { paginationData, handleCurrentChange, handleSizeChange }
+  return { paginationData, resetToFirstPage }
 }
