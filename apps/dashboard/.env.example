# Copy to apps/dashboard/.env.local (never commit the real file). On Vercel, set the same names in Project → Settings → Environment Variables.
# Google OAuth client (Google Cloud console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URIs: http://localhost:5174/api/auth/callback and https://<your-domain>/api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32+ random characters; signs the session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: the public origin, if the request host is not it (e.g. behind a proxy)
APP_URL=
# Optional: 0 hides "Continue as guest"
ALLOW_GUEST=1
